# ===================================================
# Docker Ignore - Minimize build context for Railway
# ===================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files - NEVER include
.env
.env.*
*.env
.env.local
.env.production
.env.development

# Testing (not needed in production)
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
tests/
test_*.py
*_test.py
conftest.py

# Dev tools config
.flake8
.isort.cfg
mypy.ini
pytest.ini
setup.cfg
pyproject.toml

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation (not needed in runtime)
*.md
README*
CHANGELOG*
docs/
documentation/

# Git
.git/
.gitignore
.gitattributes
.github/

# Logs
*.log
logs/

# Temporary files
temp/
tmp/
*.tmp
*.temp

# Database files
*.db
*.sqlite
*.sqlite3

# Test fixtures
tests/
fixtures/
test_data/

# Scripts (not needed in runtime)
scripts/

# Heavy audio processor (we use lite version)
audio_processor.py

# Dev requirements
requirements-dev.txt

# Local development files
.editorconfig
Makefile
docker-compose*.yml
docker-compose*.yaml

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Coverage reports
coverage.xml
*.coverage

# Build artifacts
*.tar
*.tar.gz
*.zip
